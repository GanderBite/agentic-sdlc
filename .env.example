# PostgreSQL connection
POSTGRES_USER=medbridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medbridge

# Full connection string consumed by Drizzle / api
DATABASE_URL=postgres://medbridge:change-me@localhost:5432/medbridge

# JWT signing secrets — both must be at least 32 characters
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-chars

# Application environment: development | production | test
NODE_ENV=production

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
