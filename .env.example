# Database
DATABASE_URL=postgres://user:pass@localhost:5432/medbridge

# Postgres service (docker compose)
POSTGRES_USER=medbridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medbridge

# Auth
JWT_SECRET=change-me
SESSION_TTL=900
REFRESH_TTL=604800

# Uploads
UPLOAD_DIR=/var/lib/medbridge/uploads

# Logging
LOG_LEVEL=info

# Server
PORT=3000

# Seed
SEED_PASSWORD=CorrectHorseBatteryStaple1!
