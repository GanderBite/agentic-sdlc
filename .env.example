# Database
DATABASE_URL=postgres://medbridge:change-me@localhost:5432/medbridge

# Authentication
JWT_SECRET=change-me-jwt-secret-min-32-chars
SESSION_TTL=900
REFRESH_TTL=604800

# File uploads
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# Seed script (apps/api/src/seed/main.ts)
# Password hashed via argon2id and inserted for the two seed users.
# Override in CI/staging; the default is safe only for local dev.
SEED_PASSWORD=CorrectHorseBatteryStaple1!
