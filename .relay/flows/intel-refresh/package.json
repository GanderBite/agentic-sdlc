{
  "name": "intel-refresh",
  "version": "0.1.0",
  "description": "Diff-only refresh of INTEL.md and .planning/intel/* against the current HEAD.",
  "type": "module",
  "main": "./dist/flow.js",
  "files": [
    "dist",
    "prompts",
    "schemas",
    "templates",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/prompts && cp -R prompts dist/prompts",
    "test": "relay test ."
  },
  "peerDependencies": {
    "@ganderbite/relay-core": "^0.7.2"
  },
  "devDependencies": {
    "@ganderbite/relay-core": "^0.7.2",
    "@types/node": "^25.6.2",
    "typescript": "^5.7.0"
  },
  "relay": {
    "flowName": "intel-refresh",
    "displayName": "intel-refresh",
    "tags": [
      "sdlc",
      "intel",
      "maintenance"
    ],
    "estimatedCostUsd": {
      "min": 0.05,
      "max": 0.5
    },
    "estimatedDurationMin": {
      "min": 1,
      "max": 10
    },
    "audience": [
      "dev"
    ]
  }
}
