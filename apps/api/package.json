{
  "name": "@medbridge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "start": "node dist/main.js",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "seed": "node dist/seed/main.js"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/node-server": "^1.0.0",
    "drizzle-orm": "^0.38.0",
    "pg": "^8.13.0",
    "jose": "^5.9.0",
    "argon2": "^0.41.0",
    "pino": "^9.5.0",
    "zod": "^4.0.0",
    "@medbridge/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "drizzle-kit": "^0.30.0",
    "@testcontainers/postgresql": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10"
  }
}
